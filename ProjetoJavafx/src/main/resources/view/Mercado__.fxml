<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.Mercado__Controller">

    <top>
        <VBox alignment="CENTER" spacing="8">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="MERCADO"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Informe os preços e as quantidades dos produtos."/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="20" bottom="10" left="20"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Arroz (5 kg)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco0" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd0" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Feijão (1 a 2 kg)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco1" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd1" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Óleo de soja (900 ml)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco2" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd2" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Açúcar (1 kg)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco3" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd3" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Café (250 g ou 500 g)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco4" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd4" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Macarrão (500 g)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco5" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd5" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Farinha (500 g ou 1 kg)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco6" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd6" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Fubá (500 g)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco7" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd7" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Molho de tomate (300 g)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco8" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd8" prefWidth="90"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Sal refinado (1 kg)" prefWidth="220"/>
                        <Label text="Preço unitário (R$):"/>
                        <TextField fx:id="txtPreco9" promptText="Preço" prefWidth="100"/>
                        <Label text="Quantidade:"/>
                        <Spinner fx:id="spnQtd9" prefWidth="90"/>
                    </HBox>

                    <Button text="Calcular compra"
                            onAction="#calcularCompra"
                            maxWidth="Infinity"/>

                    <Button text="Sair"
                            onAction="#sair"
                            maxWidth="Infinity"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="tabelaCaixa" prefHeight="180">
                <columns>
                    <TableColumn fx:id="colProduto" text="Produto" prefWidth="220"/>
                    <TableColumn fx:id="colQuantidade" text="Quantidade" prefWidth="100"/>
                    <TableColumn fx:id="colParcial" text="Preço parcial (R$)" prefWidth="150"/>
                </columns>
            </TableView>

            <Label fx:id="lblSubtotal" text="Subtotal: R$ 0,00"/>
            <Label fx:id="lblDesconto" text="Desconto: R$ 0,00"/>
            <Label fx:id="lblTotal" text="Total a pagar: R$ 0,00"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </bottom>

</BorderPane>