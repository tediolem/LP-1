<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="16" prefWidth="600" prefHeight="400" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.Multiplo__Controller">
 <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
 <Label text="Verificar Múltiplo" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
 <GridPane hgap="12" vgap="14" alignment="CENTER">
  <Label text="Primeiro número:" GridPane.rowIndex="0" GridPane.columnIndex="0"/><TextField fx:id="txtNumero1" promptText="Digite um inteiro" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
  <Label text="Segundo número:" GridPane.rowIndex="1" GridPane.columnIndex="0"/><TextField fx:id="txtNumero2" promptText="Digite um inteiro" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
 </GridPane>
 <Button text="Verificar" onAction="#verificarMultiplo"/><Label fx:id="lblResultado" wrapText="true" style="-fx-font-size: 16px;"/><Button fx:id="btnVoltar" text="Voltar ao menu" onAction="#voltarMenu"/>
</VBox>
